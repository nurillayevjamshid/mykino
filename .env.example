# ===== Bot =====
# @BotFather'dan olingan YANGI bot tokeni (eski bot tokeni emas!)
BOT_TOKEN=123456:telegram-bot-token
# Mini app havolalari shu bot username'i orqali quriladi (t.me/<username>?startapp=...)
BOT_USERNAME=myntv_bot

# Bot almashganda eski obunachilarni admin panelda yashirish uchun chegara sana
# (YYYY-MM-DD). Shu sanadan OLDIN /start bosganlar ro'yxatda ko'rinmaydi, lekin
# bazada saqlanib qoladi. Bo'sh qoldirilsa — barcha obunachilar ko'rinadi.
# DIQQAT: sana UTC bo'yicha yoziladi va vaqt mintaqasi hisobga olinmaydi.
BOT_LAUNCH_DATE=

# ===== Mini app manzili =====
# Vercel'dagi production domen. Oxirida "/" bo'lmasin.
# Bot tugmalari, ulashish havolalari va CORS shu manzilga tayanadi.
WEBAPP_URL=https://kino-telegram-mini-app.vercel.app
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ===== Kontent kanali (bot kinolarni shu kanaldan o'qiydi) =====
CONTENT_CHANNEL_USERNAME=mdtsitsibtaryyarbeaa
CONTENT_CHANNEL_ID=

# ===== Google Drive katalog =====
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# ===== YouTube (musiqa bo'limi) =====
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_PLAYLIST_ID=PLrW0WsV8cL9Rug7pLf8D8NOqEI7YeO6kE
YOUTUBE_MAX_PAGES=4

# ===== Aloqa =====
CONTACT_USERNAME=your_support_username
# Mini app'dagi "Murojaat qoldirish" xabarlari tushadigan guruh ID (manfiy son, -100... bilan)
FEEDBACK_GROUP_ID=

# ===== Admin panel =====
# Bo'sh qolsa "admin123" ishlatiladi — productionda albatta o'zgartiring!
ADMIN_PASSWORD=change-me
# Admin sessiya tokeni uchun ixtiyoriy sir. Bo'lmasa ADMIN_PASSWORD ishlatiladi.
ADMIN_SESSION_SECRET=

# ===== Cloudflare R2 (poster/rasm saqlash) =====
# Beshtasi ham to'ldirilishi shart, aks holda admin panelda rasm yuklab bo'lmaydi
# (R2_CONFIG_MISSING xatosi chiqadi). POSTER'lar esa Drive thumbnail'iga tushadi.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
