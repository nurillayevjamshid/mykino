# Bu faylni .mykino-r2.env nomi bilan nusxalang.
# Secretlarni GitHub'ga yuklamang; .gitignore bu faylni himoya qiladi.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://r2.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GOOGLE_DRIVE_FOLDER_ID=
